# UTILITAIRES
# ═══════════════════════════════════════════════════════════════════════════
def slugify(text):
text = text.lower()
text = re.sub(r"[^a-z0-9]+", "-", text)
return text.strip("-")


def esc(s):
if s is None:
return ""
return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace('"', "&quot;")


def parse_cookies(header):
cookies = {}
if not header:
return cookies
for part in header.split(";"):
if "=" in part:
k, v = part.split("=", 1)
cookies[k.strip()] = v.strip()
return cookies


