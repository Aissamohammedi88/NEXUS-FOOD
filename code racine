# ═══════════════════════════════════════════════════════════════════════════
# HTTP HANDLER
# ═══════════════════════════════════════════════════════════════════════════
class Handler(http.server.BaseHTTPRequestHandler):

def log_message(self, *a):
pass

def _send(self, code, body, ctype="text/html; charset=utf-8", cookies=None):
if isinstance(body, str):
body = body.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", ctype)
self.send_header("Content-Length", str(len(body)))
if cookies:
for c in cookies:
self.send_header("Set-Cookie", c)
self.end_headers()
try:
self.wfile.write(body)
except Exception:
pass

def _redirect(self, url, cookies=None):
self.send_response(302)
self.send_header("Location", url)
if cookies:
for c in cookies:
self.send_header("Set-Cookie", c)
self.end_headers()

def _user(self):
cookies = parse_cookies(self.headers.get("Cookie", ""))
token = cookies.get("session")
return get_user_from_session(token)

def _read_post(self):
try:
n = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(n).decode("utf-8") if n else ""
return urllib.parse.parse_qs(body)
except Exception:
return {}

def do_GET(self):
path = urllib.parse.urlparse(self.path).path
user = self._user()

try:
if path == "/":
self._send(200, page_accueil(user))
elif path == "/explore":
self._send(200, page_explore(user))
elif path == "/trending":
self._send(200, page_trending(user))
elif path == "/create":
self._send(200, page_create(user))
elif path == "/issues":
self._send(200, page_issues(user))
elif path == "/pulls":
self._send(200, page_pulls(user))
elif path == "/login":
self._send(200, page_login())
elif path == "/register":
self._send(200, page_register())
elif path == "/logout":
self._redirect("/", cookies=["session=; Path=/; Max-Age=0"])
elif path.startswith("/recipe/"):
slug = path[8:]
self._send(200, page_recipe(slug, user))
elif path.startswith("/profil/"):
username = path[8:]
self._send(200, page_profil(username, user))
elif path.startswith("/fork/"):
slug = path[6:]
self._send(200, page_fork(slug, user))
else:
self._send(404, layout("404", '<div class="alert error">Page introuvable</div>', user))
except Exception as e:
self._send(500, layout("Erreur", '<div class="alert error">Erreur : ' + esc(str(e)) + '</div>', user))

def do_POST(self):
path = urllib.parse.urlparse(self.path).path
data = self._read_post()
user = self._user()

def get(key):
return data.get(key, [""])[0].strip()

try:
# LOGIN
if path == "/login":
username = get("username")
password = get("password")
conn = db()
u = conn.execute("SELECT * FROM users WHERE username=?", (username,)).fetchone()
conn.close()
if u and verify_password(password, u["password_hash"]):
token = create_session(u["id"])
self._redirect("/", cookies=["session=" + token + "; Path=/; Max-Age=2592000"])
else:
self._send(200, page_login("Identifiants invalides"))

# REGISTER
elif path == "/register":
username = get("username")
email = get("email")
password = get("password")
bio = get("bio")
if len(username) < 3 or len(password) < 6:
self._send(200, page_register("Nom (3+) ou mot de passe (6+) trop court"))
return
conn = db()
try:
cur = conn.execute(
"INSERT INTO users (username, email, password_hash, bio, created_at) "
"VALUES (?,?,?,?,?)",
(username, email, hash_password(password), bio, datetime.now().isoformat())
)
uid = cur.lastrowid
conn.commit()
token = create_session(uid)
conn.close()
self._redirect("/", cookies=["session=" + token + "; Path=/; Max-Age=2592000"])
except sqlite3.IntegrityError:
conn.close()
self._send(200, page_register("Nom ou email deja pris"))

# CREATE RECIPE
elif path == "/create":
if not user:
self._redirect("/login")
return
name = get("name")
description = get("description")
difficulty = int(get("difficulty") or 3)
prep_time = int(get("prep_time") or 30)
portions = int(get("portions") or 4)
ing_raw = get("ingredients")
steps_raw = get("steps")
tags_raw = get("tags")

ingredients = []
for line in ing_raw.split("\n"):
line = line.strip()
if "|" in line:
parts = line.split("|", 1)
ingredients.append({"nom": parts[0].strip(), "qty": parts[1].strip()})
elif line:
ingredients.append({"nom": line, "qty": ""})

steps = [s.strip() for s in steps_raw.split("\n") if s.strip()]
tags = [t.strip() for t in tags_raw.split(",") if t.strip()]

